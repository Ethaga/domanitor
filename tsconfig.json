{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["app/**/*", "components/**/*", "lib/**/*"],
  "exclude": ["node_modules", ".next", "dist"]
}
